{
  "name": "@shreyanshojha/context-compiler",
  "version": "0.6.8",
  "description": "Automatically compile the right slice of a repo into context for AI coding agents.",
  "license": "MIT",
  "author": "Shreyansh Ojha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreyanshojha/context-compiler.git"
  },
  "homepage": "https://github.com/shreyanshojha/context-compiler#readme",
  "bugs": {
    "url": "https://github.com/shreyanshojha/context-compiler/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "coding-agent",
    "context",
    "embeddings",
    "rag",
    "tree-sitter",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "context-compiler": "./dist/cli.js",
    "context-compiler-mcp": "./dist/mcpServer.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "node -e \"require('fs').existsSync('tsconfig.json') && require('child_process').execSync('npm run build', {stdio:'inherit'})\"",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "stress": "npm run build && node scripts/stress-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "gpt-tokenizer": "^2.5.1",
    "ignore": "^5.3.2",
    "openai": "^4.68.0",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
